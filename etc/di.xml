<?xml version="1.0"?>
<!--
/**
 * Service contract bindings: each Api interface (and its Data result interface) is bound to its Model
 * implementation so the Magento webapi runtime can resolve and serialize them.
 */
-->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <!-- Services -->
    <preference for="Venuno\OrderImport\Api\SourceFinancialsInterface" type="Venuno\OrderImport\Model\SourceFinancials"/>
    <preference for="Venuno\OrderImport\Api\Data\SourceFinancialsResultInterface" type="Venuno\OrderImport\Model\Data\SourceFinancialsResult"/>
    <preference for="Venuno\OrderImport\Api\HealthInterface"
                type="Venuno\OrderImport\Model\Health"/>
    <preference for="Venuno\OrderImport\Api\VersionInterface"
                type="Venuno\OrderImport\Model\Version"/>
    <preference for="Venuno\OrderImport\Api\CapabilitiesInterface"
                type="Venuno\OrderImport\Model\Capabilities"/>
    <preference for="Venuno\OrderImport\Api\OrderSyncInterface" type="Venuno\OrderImport\Model\OrderSync"/>
    <preference for="Venuno\OrderImport\Api\Data\OrderSyncResultInterface" type="Venuno\OrderImport\Model\Data\OrderSyncResult"/>
    <preference for="Venuno\OrderImport\Api\OrderImportInterface"
                type="Venuno\OrderImport\Model\OrderImport"/>

    <!-- Result / request DTOs -->
    <preference for="Venuno\OrderImport\Api\Data\HealthResultInterface"
                type="Venuno\OrderImport\Model\Data\HealthResult"/>
    <preference for="Venuno\OrderImport\Api\Data\VersionResultInterface"
                type="Venuno\OrderImport\Model\Data\VersionResult"/>
    <preference for="Venuno\OrderImport\Api\Data\CapabilitiesResultInterface"
                type="Venuno\OrderImport\Model\Data\CapabilitiesResult"/>
    <preference for="Venuno\OrderImport\Api\Data\OrderImportRequestInterface"
                type="Venuno\OrderImport\Model\Data\OrderImportRequest"/>
    <preference for="Venuno\OrderImport\Api\Data\OrderImportResultInterface"
                type="Venuno\OrderImport\Model\Data\OrderImportResult"/>

    <!-- Materialisation (0.3): bind the Magento-free orchestration seams to their Magento implementations -->
    <preference for="Venuno\OrderImport\Model\Materialisation\ImportRowStoreInterface"
                type="Venuno\OrderImport\Model\OrderImportRepository"/>
    <preference for="Venuno\OrderImport\Model\Materialisation\NativeOrderGatewayInterface"
                type="Venuno\OrderImport\Model\Materialisation\NativeOrderGateway"/>
    <preference for="Venuno\OrderImport\Model\Materialisation\TransactionRunnerInterface"
                type="Venuno\OrderImport\Model\Materialisation\MagentoTransactionRunner"/>

    <!-- Materialisation (0.4): destination customer linking. The link decision is the Magento-free
         CustomerLinkPlanner; the (email, website) lookup seam is bound to its Magento implementation. -->
    <preference for="Venuno\OrderImport\Model\Materialisation\DestinationCustomerResolverInterface"
                type="Venuno\OrderImport\Model\Materialisation\MagentoDestinationCustomerResolver"/>

    <type name="Magento\Sales\Api\OrderRepositoryInterface">
        <plugin name="venuno_order_import_account_reference"
                type="Venuno\OrderImport\Plugin\Sales\OrderRepositoryPlugin"/>
    </type>
    <type name="Venuno\OrderImport\Model\Materialisation\SourceMetadataPersistence">
        <arguments>
            <argument name="orderGrid" xsi:type="object">Magento\Sales\Model\ResourceModel\Order\Grid</argument>
        </arguments>
    </type>

    <!-- 0.6: legacy order sync CLI (venuno:orders:sync) -->
    <type name="Magento\Framework\Console\CommandListInterface">
        <arguments>
            <argument name="commands" xsi:type="array">
                <item name="venuno_orders_sync" xsi:type="object">Venuno\OrderImport\Console\Command\OrderSyncCommand\Proxy</item>
            </argument>
        </arguments>
    </type>
    <type name="Venuno\OrderImport\Console\Command\OrderSyncCommand">
        <arguments>
            <argument name="service" xsi:type="object">Venuno\OrderImport\Model\Sync\OrderSyncService\Proxy</argument>
        </arguments>
    </type>
</config>
